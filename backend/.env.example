# Required for first-run admin password hashing. Use at least 12 characters.
ERP_ADMIN_PASSWORD=replace-with-a-long-random-password

# Required in production. Keep stable across restarts and never commit the real value.
JWT_SECRET=replace-with-a-long-random-secret

# Optional frontend origin for CORS.
FRONTEND_ORIGIN=http://localhost:5173

# Optional JWT lifetime. Examples: 8h, 1d
JWT_EXPIRES_IN=8h

# PostgreSQL connection used by db:migrate and the future repository layer.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/manufacturing_erp
DATABASE_POOL_MAX=10
DATABASE_SSL=false
