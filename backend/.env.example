# Required for first-run admin password hashing. Use at least 12 characters.
ERP_ADMIN_PASSWORD=replace-with-a-long-random-password

# Required in production. Keep stable across restarts and never commit the real value.
JWT_SECRET=replace-with-a-long-random-secret

# Optional frontend origins for CORS. Use comma-separated URLs and no trailing slashes.
FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_ORIGINS=http://localhost:5173,https://your-production-app.vercel.app
VERCEL_PROJECT_SLUG=your-vercel-project-slug
VERCEL_ALLOWED_DOMAINS=your-custom-domain.com

# Optional JWT lifetime. Examples: 8h, 1d
JWT_EXPIRES_IN=8h

# PostgreSQL connection used by db:migrate and the future repository layer.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/manufacturing_erp
DATABASE_POOL_MAX=5
DATABASE_CONNECTION_TIMEOUT_MS=8000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_SSL=false

# Optional background MRP worker. Leave 0 to run only via /api/mrp/run-engine.
MRP_RUN_INTERVAL_MINUTES=0

# Optional AI intake provider. Configure one provider before using /api/ai-intake/quote-extraction.
AI_MODEL_PROVIDER=openai
AI_MODEL_NAME=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
